POSTGRES_DB=rag_course
POSTGRES_USER=rag_course
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://rag_course:change-me-local-only@db:5432/rag_course
NEXT_PUBLIC_CORE_API_URL=http://localhost:8000
POSTGRES_PORT=5432
CORE_PORT=8000
DOCUMENT_PORT=8001
AI_PORT=8002
LEARNING_PORT=8003
WEB_PORT=3000
# Optional Learning / AI origins for Next.js /api/learning/v1 and /api/ai/v1 proxies (leave empty for Core+Document mode)
# LEARNING_API_URL=http://localhost:8003
AI_API_URL=
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=3
# Default notifications per page (1-100)
NOTIFICATION_PAGE_SIZE_DEFAULT=20

# Document defaults for local Compose only. Do not put real secrets in this example.
DOCUMENT_DB_USER=document_svc
DOCUMENT_DB_PASSWORD=document-change-me-local-only
DOCUMENT_DATABASE_URL=postgresql+psycopg://document_svc:document-change-me-local-only@db:5432/rag_course
DOCUMENT_MAX_SIZE_BYTES=20971520
DOCUMENT_MAX_PAGES=300
# Compose uses service DNS for upstreams. Use apps/web/.env.example for host-run Web.
# DOCUMENT_API_URL=http://document:8001
# CORE_API_URL=http://core:8000

# Local Compose example only. Replace DB credentials and URL together; URL-encode special characters.
# Provide distinct random secrets (at least 32 characters) to enable authentication/internal access.
# SECRET_KEY=
# INTERNAL_SERVICE_SECRET=

# Optional local-only defaults when starting Compose with the full-stack overlay.
# Set distinct secrets to override these defaults. Learning and AI share each matching key for internal calls.
# LEARNING_INTERNAL_SERVICE_SECRET=local-learning-internal-secret
# AI_INTERNAL_SERVICE_SECRET=local-ai-internal-secret
# AI_ANALYTICS_SERVICE_SECRET=local-ai-analytics-secret

STUDENT_ACTIVATION_EXPIRE_HOURS=24
# SMTP and PUBLIC_WEB_URL are needed for staff invitation/recovery links. Student codes are
# handed to Admin directly; the Core worker does not email Student activation/reset codes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=10
