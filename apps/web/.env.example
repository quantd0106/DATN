# Live is the default. npm run dev:mock is the only preview entry point.
NEXT_PUBLIC_DATA_MODE=live
# Server-only upstreams. Browser always calls same-origin /api/v1, /api/learning/v1, /api/ai/v1.
CORE_API_URL=http://localhost:8000
DOCUMENT_API_URL=http://localhost:8001
# AI Tutor & Quiz is proxied separately through /api/ai/v1 (compose.full.yaml exposes AI on host port 8002).
AI_API_URL=http://localhost:8002
# Learning is proxied separately through /api/learning/v1.
LEARNING_API_URL=http://localhost:8003
WEB_ORIGIN=http://localhost:3000
# Add your web origin to Core CORS_ORIGINS. Cookie Secure must match HTTPS usage.
# No API/service key belongs in NEXT_PUBLIC_* variables.
