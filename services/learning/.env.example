LEARNING_DATABASE_URL=postgresql+psycopg://learning_service:change-me-local-only@host.docker.internal:5432/rag_course
LEARNING_DATABASE_POOL_SIZE=5
LEARNING_DATABASE_MAX_OVERFLOW=5
LEARNING_DATABASE_POOL_TIMEOUT_SECONDS=3
LEARNING_DATABASE_CONNECT_TIMEOUT_SECONDS=3
LEARNING_CORS_ORIGINS=["http://localhost:3000"]
LEARNING_ENVIRONMENT=service
LEARNING_DEPENDENCY_TIMEOUT_SECONDS=3

CORE_API_URL=http://host.docker.internal:8000
CORE_JWT_SECRET=replace-with-shared-core-hs256-secret-32-chars
CORE_SERVICE_KEY=replace-with-core-internal-service-secret

LEARNING_INTERNAL_SERVICE_SECRET=replace-with-learning-internal-secret
LEARNING_ANALYTICS_SERVICE_SECRET=replace-with-learning-analytics-secret

AI_MODE=disabled
AI_API_URL=http://host.docker.internal:8001
AI_SERVICE_KEY=

DOCUMENT_MODE=disabled
DOCUMENT_API_URL=http://host.docker.internal:8002
DOCUMENT_SERVICE_KEY=

BLOB_STORAGE_DIR=/var/lib/learning-blobs
ASSIGNMENT_MAX_UPLOAD_BYTES=26214400
DEFAULT_APPEAL_WINDOW_DAYS=7
SWEEPER_INTERVAL_SECONDS=10
